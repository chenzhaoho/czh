create_clock -name clk_a -period 10.000 [get_ports clk_a]
create_clock -name clk_b -period 14.000 [get_ports clk_b]
set_false_path -from [get_ports rst_n_async]
create_generated_clock -name activity_clock_a -source [get_pins forward_a/C] -divide_by 1 -invert [get_ports activity_clk_a]
create_generated_clock -name activity_clock_b -source [get_pins forward_b/C] -divide_by 1 -invert [get_ports activity_clk_b]
set_output_delay -clock activity_clock_a -max 2.0 [get_ports activity_a]
set_output_delay -clock activity_clock_a -min 0.0 [get_ports activity_a]
set_output_delay -clock activity_clock_b -max 2.0 [get_ports activity_b]
set_output_delay -clock activity_clock_b -min 0.0 [get_ports activity_b]
set_property IOSTANDARD LVCMOS33 [get_ports *]
set_property SLEW FAST [get_ports {activity_a activity_b activity_clk_a activity_clk_b}]
